{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abhinav-official/heart/blob/main/heart.schema.json",
  "title": "Heart Lock",
  "description": "JSON Schema describing heart.lock: a project's frozen heart - what, why, whom.",
  "type": "object",
  "additionalProperties": false,
  "required": ["what", "why", "whom", "frozen_at", "freezes"],
  "properties": {
    "what": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\n\\r]*$",
      "description": "What the project is, in one line."
    },
    "why": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\n\\r]*$",
      "description": "Why the project exists, in one line. Must equal the last freeze's why."
    },
    "whom": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\n\\r]*$",
      "description": "Whom the project is for, in one line."
    },
    "frozen_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the latest freeze."
    },
    "freezes": {
      "type": "array",
      "minItems": 1,
      "description": "Append-only freeze history, oldest first.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "why", "note"],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of this freeze."
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\n\\r]*$",
            "description": "The project's why at this freeze."
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\n\\r]*$",
            "description": "One line explaining why the why changed."
          }
        }
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edit_permission", "reason", "instruction"],
      "description": "Lock instruction for AI agents. No project meaning. Optional for validity; init always writes it.",
      "properties": {
        "edit_permission": {
          "type": "string",
          "enum": ["denied"],
          "description": "Fixed text, not a setting: only valid value is denied."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\n\\r]*$",
          "description": "Why this file is locked."
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\n\\r]*$",
          "description": "What AI agents should do before working."
        }
      }
    }
  }
}
