{
  "name": "heartlock",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "bin": {
    "heart": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node -e \"import{writeFileSync,chmodSync}from'node:fs';writeFileSync('dist/cli.js','#!/usr/bin/env node\\nimport \\\"./src/cli.js\\\";\\n');chmodSync('dist/cli.js',0o755)\"",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "heart.schema.json",
    "SPEC.md",
    "README.md",
    "LICENSE"
  ]
}
